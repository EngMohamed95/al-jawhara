JAWAHARA_FTP_HOST=your-ftps-host.example.com
JAWAHARA_FTP_USER=your-ftps-username
JAWAHARA_FTP_PASSWORD=replace-with-a-new-password

# Leave unset for normal certificate verification. Use 1 only temporarily if
# the hosting provider confirms that its FTPS certificate cannot be verified.
JAWAHARA_FTP_ALLOW_INSECURE=0
